{
  "id": "wind_ear_idle",
  "speaker": "風耳",
  "rules": [
    {
      "when": {
        "flags": [
          "boss.shadowwind_cleared"
        ]
      },
      "lines": [
        "風肯停了。你等過風。",
        "海岸還在吼。堡壘若問，就說：你等過風。"
      ]
    },
    {
      "when": {
        "flags": [
          "c4_entered"
        ]
      },
      "lines": [
        "你若要見疾影——先學會等。風停的那一下，才是真的。",
        "別追殘影。等停拍，再射。頭銜追不上風。"
      ]
    },
    {
      "when": {},
      "lines": [
        "林裡認停拍，不認頭銜。走得慢，很好。"
      ]
    }
  ]
}
