{
  "id": "greybeard",
  "speaker": "灰须",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "又一次。还记得拔剑拔三次吗？",
        "狮子更躁。格挡别松。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔塌了一角。你还站着。进来喝茶。",
        "团里当你最弱。堡里已经不那么想。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "雾也看破了？眼睛比剑先长。",
        "塔在等。别自称勇者。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "门为你开。",
        "东南有雾。信会慢，人别慢。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃有了。狮子不听人话，听刀。",
        "不是去证明你强。让它想起该守什么。"
      ]
    },
    {
      "when": {},
      "lines": [
        "佣兵团最弱的？圣狮在内殿。先把剑养好。",
        "招是打中了才会长。活着回报。"
      ]
    }
  ]
}
