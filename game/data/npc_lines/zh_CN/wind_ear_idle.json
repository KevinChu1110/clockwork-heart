{
  "id": "wind_ear_idle",
  "speaker": "风耳",
  "rules": [
    {
      "when": {
        "flags": [
          "boss.shadowwind_cleared"
        ]
      },
      "lines": [
        "风肯停了。你等过风。",
        "海岸还在吼。堡垒若问，就说：你等过风。"
      ]
    },
    {
      "when": {
        "flags": [
          "c4_entered"
        ]
      },
      "lines": [
        "你若要见疾影——先学会等。风停的那一下，才是真的。",
        "别追残影。等停拍，再射。头衔追不上风。"
      ]
    },
    {
      "when": {},
      "lines": [
        "林里认停拍，不认头衔。走得慢，很好。"
      ]
    }
  ]
}
