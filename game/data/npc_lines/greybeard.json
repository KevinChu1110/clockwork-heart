{
  "id": "greybeard",
  "speaker": "灰鬚",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "又一次。還記得拔劍拔三次嗎？",
        "獅子更躁。格擋別鬆。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔塌了一角。你還站著。進來喝茶。",
        "團裡當你最弱。堡裡已經不那麼想。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧也看破了？眼睛比劍先長。",
        "塔在等。別自稱勇者。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "門為你開。",
        "東南有霧。信會慢，人別慢。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃有了。獅子不聽人話，聽刀。",
        "不是去證明你強。讓它想起該守什麼。"
      ]
    },
    {
      "when": {},
      "lines": [
        "傭兵團最弱的？聖獅在內殿。先把劍養好。",
        "招是打中了才會長。活著回報。"
      ]
    }
  ]
}
