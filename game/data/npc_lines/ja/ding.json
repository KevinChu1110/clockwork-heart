{
  "id": "ding",
  "speaker": "釘釘",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1
      },
      "lines": [
        "また来たか？刃に灰が。俺が育てるのは器で、命じゃない。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "鉄が残ってりゃいい。——葬った鉄を二度も見分けさせるな。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_done"
        ]
      },
      "lines": [
        "旧い借りは返した。炉の火は……前より少し安定してる。",
        "昇階は金がいる。情は炭代わりに燃えない。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.broken_blade"
        ]
      },
      "lines": [
        "その折れ口……演武場で拾ったのか？寄越せ。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_asked"
        ]
      },
      "lines": [
        "折れた剣は演武場の武器架のそばだ。迷ったなんて言うなよ。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "微末の刃。名は悪いが使える。昇階したけりゃ金を持ってこい。",
        "……暇があったら、演武場を見てきてくれ。旧い借りだ。"
      ]
    },
    {
      "when": {},
      "lines": [
        "門は観光用に開けてるんじゃない。団はまた一番弱いのを寄越したのか？"
      ]
    }
  ]
}
