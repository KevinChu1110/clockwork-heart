{
  "id": "fog_hide",
  "speaker": "霧隠",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "二周目の霧はもっと笑う。本体が白く光るのを待て。焦るな。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.fog_letter_done"
        ]
      },
      "lines": [
        "本物の手紙が届いた。偽の霧が一層減った。",
        "お前の目は最初より使えるようになった。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.true_letter"
        ]
      },
      "lines": [
        "手紙はお前が持ってる。岔路の行商の駅站で、本物を渡せ。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧は散った。お前の目は、まあ使える。",
        "……本物の手紙がもう一通。偽物が多すぎて、本物は手で運ぶしかない。"
      ]
    },
    {
      "when": {
        "flags": [
          "c2_wheat_letter"
        ]
      },
      "lines": [
        "影を打てば影が笑う。隙を見ろ：刃が上がるその一瞬だけが本物だ。",
        "幻廊は村の東。白霧はお前が迷うのを待ってる。"
      ]
    },
    {
      "when": {},
      "lines": [
        "まず宿へ。手紙はここまで転送されてきた。遅かった。"
      ]
    }
  ]
}
