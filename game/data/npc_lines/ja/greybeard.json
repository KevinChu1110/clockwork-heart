{
  "id": "greybeard",
  "speaker": "灰鬚",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "またか。剣を三度引いたのを覚えてるか？",
        "獅子はもっと荒れてる。受けを緩めるな。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔の角が崩れた。お前はまだ立ってる。入って茶を飲め。",
        "団はお前を一番弱いと思ってる。砦はもうそう思ってない。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧も見破ったか？目は剣より先に育つ。",
        "塔が待ってる。勇者を名乗るな。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "門はお前のために開く。",
        "南東に霧。手紙は遅れる、人は遅れるな。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃はできた。獅子は人の話を聞かない。刀を聞く。",
        "強さを証明しに行くんじゃない。何を守るべきか思い出させに行くんだ。"
      ]
    },
    {
      "when": {},
      "lines": [
        "傭兵団で一番弱いのか？聖獅は内殿にいる。まず剣を育てろ。",
        "技は当ててこそ育つ。生きて報告しろ。"
      ]
    }
  ]
}
